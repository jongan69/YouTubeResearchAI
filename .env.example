# ═══════════════════════════════════════════════════════════════════════
# YouTube Research AI — Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your API keys.
# Run `npm run doctor` to verify your setup.
#
# Documentation: https://github.com/jongan69/YouTubeResearchAI
# ═══════════════════════════════════════════════════════════════════════

# ── AI Provider ──────────────────────────────────────────────────────
# Which AI service to use for report generation.
# Supported: openai | anthropic | google | openai-compat
AI_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────────────
# Required for: OpenAI reports, Whisper transcription (all providers)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: custom base URL for OpenAI-compatible providers
# Use this for Groq, DeepSeek, Ollama, or any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic Claude ─────────────────────────────────────────────────
# Required for: Anthropic reports
# Note: Transcription still requires OPENAI_API_KEY (Whisper fallback)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_REPORT_MODEL=claude-sonnet-5-20251001
# ANTHROPIC_MAX_OUTPUT_TOKENS=16000
# ANTHROPIC_THINKING_BUDGET=16000

# ── Google Gemini ────────────────────────────────────────────────────
# Required for: Google reports
# Note: Transcription still requires OPENAI_API_KEY (Whisper fallback)
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_REPORT_MODEL=gemini-2.5-pro
# GOOGLE_MAX_OUTPUT_TOKENS=16000

# ── Transcription ────────────────────────────────────────────────────
# Transcription provider override. Defaults to openai.
# Only openai and openai-compat support transcription natively.
# TRANSCRIPTION_PROVIDER=openai

# ── Model Configuration ──────────────────────────────────────────────
# These apply to the active AI_PROVIDER.
# Leave unset for sensible provider-specific defaults.

# Transcription model
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Report generation model (overrides provider default)
# OPENAI_REPORT_MODEL=gpt-5.5

# Reasoning/thinking effort: low | medium | high
# Behavior varies by provider:
#   OpenAI: reasoning.effort
#   Anthropic: thinking.budget_tokens (low=4K, medium=16K, high=32K)
#   Google: thinkingConfig
#   OpenAI-compat: system prompt guidance
# OPENAI_REASONING_EFFORT=medium

# Writing verbosity: low | medium | high
# OPENAI_TEXT_VERBOSITY=medium

# Report output token budget
# Higher = longer, more detailed reports. Lower = cheaper.
# OPENAI_MAX_OUTPUT_TOKENS=24000

# Transcript chunk size (characters)
# Larger models (GPT-5, Claude-5, Gemini 2.5) default to 100000.
# Others default to 18000.
# OPENAI_REPORT_CHUNK_CHARS=100000

# API timeout in milliseconds
# OPENAI_TIMEOUT_MS=1200000

# ── Research: Literature Search & Citations ─────────────────────────
# Enable scholarly literature search across academic databases.
# When enabled, the pipeline searches for peer-reviewed sources
# related to the video's claims and cites them in the report.
# RESEACH_ENABLED=true

# Research depth: none | light | medium | deep
#   none   = skip research (same as not setting --research)
#   light  = top 3 results per claim
#   medium = top 5 results per claim (default when --research is on)
#   deep   = multi-pass iterative research with gap analysis
# RESEACH_DEPTH=medium

# Max sources cited in the final report
# RESEACH_MAX_SOURCES=10

# Max papers retrieved per search query per database
# RESEACH_MAX_PAPERS_PER_TOPIC=5

# Academic databases to search (comma-separated)
# Available: arxiv, semantic_scholar, crossref, openalex
# RESEACH_APIS=arxiv,semantic_scholar,crossref,openalex

# Semantic Scholar API key (optional, free signup at semanticscholar.org)
# Raises rate limit from 100 to 1000 requests per 5 minutes
# SEMANTIC_SCHOLAR_API_KEY=your-s2-key-here

# Email for CrossRef polite pool identification (recommended)
# RESEACH_MAILTO=your-email@example.com

# Citation style: apa | chicago | ieee
# CITATION_STYLE=apa

# Per-fetch timeout in milliseconds
# RESEACH_TIMEOUT_MS=15000

# ── Evidence Synthesis & Verification ────────────────────────────────
# Compare video claims against retrieved literature.
# Assigns confidence levels (well-supported, plausible, contested,
# speculative, opinion) and identifies gaps.
# Requires --research to be enabled.
# VERIFY_ENABLED=true

# ── Domain Scaffolding ───────────────────────────────────────────────
# Force a specific academic domain profile.
# Leave unset for automatic detection based on transcript content.
# Available: computer-science, medicine, social-sciences,
#            humanities, natural-sciences
# DOMAIN=computer-science

# ── Multi-Source Synthesis ───────────────────────────────────────────
# When processing 2+ videos, generate a cross-source synthesis report
# identifying consensus, disagreements, and gaps.
# SYNTHESIS=true

# ── Visual Frame Analysis ────────────────────────────────────────────
# Extract keyframes from the video and analyze with vision-capable AI.
# Extracts equations, diagrams, code, charts, and on-screen citations.
# Requires a vision-capable model.
# VISION_ENABLED=true

# Max frames to extract and analyze
# MAX_FRAMES=20

# Frames per minute of video
# FRAMES_PER_MINUTE=1

# ── Iterative Deep Research ──────────────────────────────────────────
# Maximum iterations for deep research mode (--research-depth deep).
# The pipeline stops early if no new sources are found.
# RESEACH_ITERATIONS=3
