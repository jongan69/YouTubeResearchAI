# ── AI Provider ──────────────────────────────────────────
# Which AI service to use for report generation.
# Supported: openai | anthropic | google | openai-compat
AI_PROVIDER=openai

# ── OpenAI (also used for openai-compat) ──────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: custom base URL for OpenAI-compatible providers (Groq, DeepSeek, Ollama, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic ─────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_REPORT_MODEL=claude-sonnet-5-20251001
# ANTHROPIC_MAX_OUTPUT_TOKENS=16000
# ANTHROPIC_THINKING_BUDGET=16000

# ── Google Gemini ─────────────────────────────────────────
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_REPORT_MODEL=gemini-2.5-pro
# GOOGLE_MAX_OUTPUT_TOKENS=16000

# ── Transcription ─────────────────────────────────────────
# Transcription provider override. Defaults to AI_PROVIDER if it supports it,
# otherwise falls back to OpenAI Whisper (requires OPENAI_API_KEY).
# TRANSCRIPTION_PROVIDER=openai

# ── Model overrides ───────────────────────────────────────
# These apply to the active AI_PROVIDER.
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_REPORT_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=medium
# OPENAI_TEXT_VERBOSITY=medium
# OPENAI_MAX_OUTPUT_TOKENS=24000
# OPENAI_REPORT_CHUNK_CHARS=100000
# OPENAI_TIMEOUT_MS=1200000
